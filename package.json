{
  "name": "steward",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Steward: an accounts-payable agent whose key cannot move funds.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "spike": "tsx scripts/spike-rule.ts",
    "test:sol": "scripts/forge.sh test",
    "test:ts": "vitest run",
    "typecheck": "tsc --noEmit",
    "vectors": "tsx scripts/vectors.ts",
    "cbom": "tsx scripts/cbom.ts --chain",
    "cbom:check": "tsx scripts/cbom.ts",
    "evidence": "tsx scripts/evidence.ts",
    "audit": "tsx scripts/audit.ts",
    "cli": "tsx scripts/cli.ts",
    "deploy": "tsx scripts/deploy.ts",
    "link": "tsx scripts/link-agent.ts",
    "fund": "tsx scripts/fund.ts",
    "injection-demo": "tsx --env-file-if-exists=.env scripts/injection-demo.ts",
    "llm-payment": "tsx --env-file-if-exists=.env scripts/llm-payment.ts",
    "send-qor": "tsx scripts/send-qor.ts"
  },
  "dependencies": {
    "@cosmjs/stargate": "0.39.0",
    "@noble/hashes": "2.4.0",
    "@qorechain/evm": "0.14.0",
    "@qorechain/mcp": "0.1.1",
    "@qorechain/pqc": "0.2.3",
    "@qorechain/qore-cli": "0.1.1",
    "@qorechain/qoreseal": "0.1.0",
    "@qorechain/qoresign": "0.1.0",
    "@qorechain/sdk": "0.14.0",
    "haven-pq-kit": "github:datharnu/haven-pq-kit#v0.1.0",
    "viem": "2.47.6"
  },
  "devDependencies": {
    "@qorechain/qorescan": "0.1.0",
    "@types/node": "22.19.1",
    "tsx": "4.19.4",
    "typescript": "5.6.3",
    "vitest": "3.2.4"
  }
}
